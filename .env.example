# ==============================================================================
#  AI私厨管家 · 环境变量示例
# ==============================================================================
#  用法：
#      1. 复制本文件为 .env（放在项目根目录，与 app.py 同级）
#      2. 把下面所有 your_xxx_here 替换成你自己的真实 Key
#      3. .env 已被 .gitignore 忽略，绝不会被提交到仓库
#
#  命令（Windows PowerShell）：
#      Copy-Item .env.example .env
#  命令（macOS / Linux）：
#      cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 阿里云百炼（DashScope）—— 用于 Qwen / Kimi / GLM 等模型
# ------------------------------------------------------------------------------
# 获取地址：https://bailian.console.aliyun.com/  →  API-KEY 管理
# 开通后形如 sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# OpenAI 兼容模式的接口地址（一般不用改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ------------------------------------------------------------------------------
# DeepSeek 官方 —— 用于 deepseek-chat / deepseek-reasoner 等模型
# ------------------------------------------------------------------------------
# 说明：LangChain 原生支持 DeepSeek，因此**只需要 Key，不需要 base_url**
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ------------------------------------------------------------------------------
# Tavily —— 联网搜索菜谱
# ------------------------------------------------------------------------------
# 获取地址：https://app.tavily.com/home  →  API Keys（有免费额度）
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# PostgreSQL —— 聊天记录与对话记忆
# ------------------------------------------------------------------------------
# 本地最简部署（Docker 一行起一个库）：
#     docker run -d --name langgraph-postgres \
#       -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=postgres \
#       -p 15432:5432 -v pgdata:/var/lib/postgresql/data postgres:16
#
# 然后用 schema.sql 建表（用户表 + LangGraph 检查点表）：
#     psql "postgresql://postgres:postgres@localhost:15432/postgres" -f schema.sql
#
# 想灌一份演示数据（全是假数据，可放心执行）：
#     psql "postgresql://postgres:postgres@localhost:15432/postgres" -f seed_demo.sql
DB_URI=postgresql://postgres:postgres@localhost:15432/postgres?sslmode=disable

# ------------------------------------------------------------------------------
# 可选：运行参数（不填就用代码里的默认值）
# ------------------------------------------------------------------------------
# 记忆后端：postgres（默认）| auto | sqlite | memory
# 连不上数据库时，界面会明确提示并退回内存记忆，不会崩
AI_CHEF_MEMORY_BACKEND=postgres

# 想换模型时优先改 core/model_settings.py 的 MODEL_CATALOG（界面下拉框会自动同步）
# 也可以临时用下面两个环境变量覆盖：
# AI_CHEF_TEXT_MODEL=qwen3.8-flash
# AI_CHEF_VISION_MODEL=qwen3.8-flash

# 生成参数
# AI_CHEF_LLM_TEMPERATURE=0.3
# AI_CHEF_LLM_TIMEOUT=90
# AI_CHEF_LLM_MAX_RETRIES=2

# 每次搜几条菜谱 / 搜索深度
# AI_CHEF_TAVILY_MAX_RESULTS=5
# AI_CHEF_TAVILY_DEPTH=basic

# 菜谱站白名单（英文逗号分隔；设为空字符串 = 不限站点）
# AI_CHEF_RECIPE_SITES=xiachufang.com,meishij.net,douguo.com,xiangha.com

# 单张图片大小上限（MB）
# AI_CHEF_MAX_IMAGE_MB=15

# 模型可用性自检：视觉模型默认探测，文本模型默认不探测；设为 1/0 可强制开关
# AI_CHEF_MODEL_PING=1
